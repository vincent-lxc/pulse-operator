# Copy to .env locally. Never commit .env or a real key.
# Scripts read these names from the environment only.

PRIVATE_KEY=

# --- Arc endpoints (verified against docs.arc.io, 2026-09-27) ---
# Testnet: chainId 5042002, faucet https://faucet.circle.com
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# Mainnet: chainId 5042. Deploy scripts refuse mainnet unless CONFIRM_MAINNET=1.
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_RPC_URL=https://rpc.testnet.arc.io
# CONFIRM_MAINNET=1

# --- PolicyVault (script/Deploy.s.sol:DeployPolicyVault) ---
# Operator key the AI agent signs pay() with. Must differ from the owner.
AGENT_ADDRESS=
# Optional; default = deployer
OWNER_ADDRESS=
# Optional; default = owner
RESERVE_ADDRESS=
# Optional; default = Arc native USDC ERC-20 (6 decimals)
USDC_ADDRESS=0x3600000000000000000000000000000000000000
EXPECTED_CHAIN_ID=5042002
# SEED_DEMO_POLICY=1
